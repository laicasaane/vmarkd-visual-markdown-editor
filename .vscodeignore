.vscode
.github
media-src
node_modules
src
test
coverage
DEVELOPMENT.md
.gitignore
.env
.env.*
tsconfig.json
build.mjs
package-lock.json
scripts
media/vditor/dist/js/mathjax

# Development-agent content — never ship in the .vsix
AGENTS.md
CLAUDE.md
.claude
# Development-agent skills and working state — vsce would otherwise package them.
.agents
.codebase-memory
docs
tasks
test-results
.playwright-cli
.vscode-test
tmp
# Git worktrees (a full repo copy each) — gitignored, but vsce does not read .gitignore, so it would
# otherwise walk into them and hang/bloat the package. Never ship a worktree in the .vsix.
.worktrees
.nvmrc
out/**/*.md
out/**/*.test.js

# Development tooling config and agent skill metadata — not needed at runtime
biome.json
skills-lock.json

# Source maps — debug artifacts, not needed at runtime
**/*.map
